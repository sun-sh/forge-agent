{
  "name": "forge-agent",
  "version": "0.2.0",
  "description": "A local coding agent with a Web client, planned task orchestration and verification.",
  "private": false,
  "type": "module",
  "bin": {
    "forge-agent": "./dist/pi-cli.js"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "tsx src/pi-cli.ts",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:web": "npm run build && node scripts/check-web-ui.mjs",
    "eval:smoke": "npm run build && node scripts/evaluate-agent.mjs",
    "eval:agent": "npm run build && node scripts/evaluate-agent.mjs --real",
    "eval:repo": "npm run build && node scripts/evaluate-repository.mjs",
    "pack:check": "npm run build && node scripts/check-package.mjs",
    "prepack": "npm run build",
    "check": "node scripts/check.mjs",
    "start": "node dist/pi-cli.js web",
    "check:agent": "node dist/pi-cli.js --version"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "dompurify": "3.4.17",
    "jsonc-parser": "3.3.1",
    "marked": "18.1.2",
    "proper-lockfile": "4.1.2",
    "typebox": "1.3.27",
    "yaml": "2.9.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/proper-lockfile": "4.1.4",
    "jsdom": "27.4.0",
    "tsx": "4.20.6",
    "typescript": "5.7.3",
    "vitest": "5.0.5"
  },
  "license": "MIT",
  "overrides": {
    "undici": "8.12.3",
    "minimatch": "11.0.4"
  },
  "files": [
    "dist",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "AGENTS.md",
    "docs",
    "LICENSE",
    "forge-agent.schema.json"
  ]
}
